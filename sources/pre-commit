#!/usr/bin/env python3
"""
Hardened Git Pre-Commit Secret Scanner
---------------------------------------
Blocks commits that contain secrets, high-entropy credential strings, or
known API key patterns.

Bypass (for legitimate high-entropy data / test fixtures):
    GIT_ALLOW_SECRETS=1 git commit -m "your message"

Per-line suppression:
    some_var = "value"  # git-secret-ignore
"""

import subprocess
import sys
import re
import math
import os
from typing import List, Tuple, Optional

# ─── Bypass ──────────────────────────────────────────────────────────────────

if os.environ.get("GIT_ALLOW_SECRETS") == "1":
    sys.exit(0)

# ─── Configuration ────────────────────────────────────────────────────────────

ENTROPY_THRESHOLD = 4.5
MIN_BASE64_LEN = 20   # minimum token length to entropy-check as base64
MIN_HEX_LEN = 32      # minimum token length to entropy-check as hex

# What fraction of a token's chars must be in the alphabet for it to qualify
BASE64_ALPHABET_RATIO = 0.85
HEX_ALPHABET_RATIO = 1.0   # must be 100% hex chars

BASE64_CHARS = set(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=_-"
)
HEX_CHARS = set("0123456789abcdefABCDEF")

# ─── Known Secret Patterns ────────────────────────────────────────────────────

SECRET_PATTERNS: List[Tuple[str, re.Pattern]] = [
    # OpenAI
    ("OpenAI API key",
     re.compile(r'\bsk-[A-Za-z0-9T]{20,}\b')),

    # Anthropic
    ("Anthropic API key",
     re.compile(r'\bsk-ant-[A-Za-z0-9\-_]{20,}\b')),

    # Replicate
    ("Replicate API key",
     re.compile(r'\br8_[A-Za-z0-9]{20,}\b')),

    # ElevenLabs  (sk_<2 chars>_<token>)
    ("ElevenLabs API key",
     re.compile(r'\bsk_[a-z0-9]{2}_[A-Za-z0-9]{20,}\b')),

    # Stripe
    ("Stripe secret key",
     re.compile(r'\bsk_(live|test)_[A-Za-z0-9]{24,}\b')),

    # AWS Access Key ID
    ("AWS Access Key ID",
     re.compile(r'\b(AKIA|ASIA|AROA|AIDA)[A-Z0-9]{16}\b')),

    # AWS Secret Access Key (contextual heuristic)
    ("AWS Secret Access Key",
     re.compile(
         r'(?i)aws.{0,20}secret.{0,20}[=:\s]+["\']?([A-Za-z0-9/+=]{40})["\']?'
     )),

    # GitHub personal / OAuth / app tokens (20+ chars after prefix, exact
    # GitHub length is 36 but allow flexibility for future formats)
    ("GitHub Personal Access Token",
     re.compile(r'\bghp_[A-Za-z0-9]{20,}\b')),
    ("GitHub OAuth Token",
     re.compile(r'\bgho_[A-Za-z0-9]{20,}\b')),
    ("GitHub App/Server Token",
     re.compile(r'\bghs_[A-Za-z0-9]{20,}\b')),
    ("GitHub Actions User Token",
     re.compile(r'\bghu_[A-Za-z0-9]{20,}\b')),

    # Hardcoded Bearer token in source (not runtime header construction)
    ("Hardcoded Bearer token",
     re.compile(r'(?i)bearer\s+[A-Za-z0-9\-._~+/]{20,}={0,2}\b')),

    # PEM private key header
    ("Private key (PEM header)",
     re.compile(
         r'-----BEGIN\s+(RSA\s+|EC\s+|DSA\s+|OPENSSH\s+|PGP\s+)?PRIVATE KEY(\s+BLOCK)?-----'
     )),

    # Database / service connection strings with embedded credentials
    ("Connection string with embedded password",
     re.compile(
         r'(?i)(mysql|postgres(?:ql)?|mongodb(?:\+srv)?|redis|amqp|amqps|jdbc|odbc)'
         r'://[^:@\s]{1,64}:[^@\s/]{3,}@'
     )),

    # Generic hardcoded assignment patterns
    ("Hardcoded secret/password/token assignment",
     re.compile(
         r'(?i)\b(password|passwd|secret|api_?key|auth_?token|access_?token|private_?key)'
         r'\s*[=:]\s*["\'][^"\']{8,}["\']'
     )),

    # Slack webhook
    ("Slack Incoming Webhook URL",
     re.compile(
         r'https://hooks\.slack\.com/services/T[A-Z0-9]{8,}/B[A-Z0-9]{8,}/[A-Za-z0-9]{24,}'
     )),

    # SendGrid
    ("SendGrid API key",
     re.compile(r'\bSG\.[A-Za-z0-9\-_]{22,}\.[A-Za-z0-9\-_]{43,}\b')),

    # Twilio (SID + contextual auth token)
    ("Twilio Account SID",
     re.compile(r'\bAC[a-f0-9]{32}\b')),
]

# ─── Allowlist / False-positive suppression ───────────────────────────────────

# If a line matches ANY of these, it is skipped entirely
ALLOWLIST_LINE_PATTERNS: List[re.Pattern] = [
    re.compile(r'#\s*git-secret-ignore', re.IGNORECASE),
    re.compile(r'#\s*nosec', re.IGNORECASE),
    re.compile(r'#\s*noqa', re.IGNORECASE),
    re.compile(r'\bexample\b', re.IGNORECASE),
    re.compile(r'\bplaceholder\b', re.IGNORECASE),
    re.compile(r'your[_\-\+]?(api[_\-\+]?)?key', re.IGNORECASE),
    re.compile(r'<[A-Z][A-Z0-9_]{2,}>'),          # <MY_API_KEY>
    re.compile(r'\$\{[A-Z][A-Z0-9_]{2,}\}'),       # ${MY_API_KEY}
    re.compile(r'\$[A-Z][A-Z0-9_]{2,}\b'),          # $MY_API_KEY
    re.compile(r'os\.environ'),                      # already using env var
    re.compile(r'process\.env'),                     # already using env var (JS)
    re.compile(r'getenv', re.IGNORECASE),
    # Public social media / newsletter URLs in this corpus are not secrets
    re.compile(r'\b(twitter|x)\.com/[^/\s]+/status/\d+', re.IGNORECASE),
    re.compile(r'\b(twitter|x)\.com/[^/\s]+/statuses/\d+', re.IGNORECASE),
    re.compile(r'https?://defenderofthebasic\.substack\.com/', re.IGNORECASE),
    re.compile(r'\bdefenderofthebasic\.substack\.com/', re.IGNORECASE),
    # Hermes tool-call artefacts are internal IDs / encrypted reasoning, not secrets
    re.compile(r'\bcall_[A-Za-z0-9_\-]{20,}\b'),
    re.compile(r'\bfc_[A-Za-z0-9_\-]{30,}\b'),
    re.compile(r'\bgAAAAA[A-Za-z0-9+/=_\-]{20,}\b'),
    # Hermes tool_call_id / function call references
    re.compile(r'(?i)(?:tool_call_id|function_call_id|reasoning_items|encrypted_content)\b'),
    # Hermes delegation / temp paths are not secrets
    re.compile(r'/var/folders/[^ ]+'),
    re.compile(r'/Users/\S+\.hermes/cache/delegation', re.IGNORECASE),
    re.compile(r'/Users/\S+\.hermes/export', re.IGNORECASE),
]

# File extensions to skip (binary, lock files, generated assets)
SKIP_EXTENSIONS: set = {
    '.png', '.jpg', '.jpeg', '.gif', '.webp', '.ico', '.svg', '.bmp', '.tiff',
    '.pdf', '.zip', '.tar', '.gz', '.tgz', '.bz2', '.xz', '.rar', '.7z',
    '.woff', '.woff2', '.ttf', '.eot', '.otf',
    '.mp3', '.mp4', '.mov', '.avi', '.mkv', '.wav', '.ogg', '.flac',
    '.pyc', '.pyo', '.class', '.o', '.so', '.dylib', '.dll', '.exe',
    '.lock',
}

# Specific filenames to skip entirely
SKIP_FILES: set = {
    'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml',
    'poetry.lock', 'Pipfile.lock', 'Gemfile.lock',
    'Cargo.lock', 'go.sum', 'composer.lock',
    '.env.example', '.env.sample', '.env.template', '.env.test',
}


# ─── Shannon Entropy ──────────────────────────────────────────────────────────

def shannon_entropy(s: str) -> float:
    """H = -sum(p_i * log2(p_i)) over all unique characters."""
    if not s:
        return 0.0
    n = len(s)
    freq: dict = {}
    for ch in s:
        freq[ch] = freq.get(ch, 0) + 1
    return -sum((c / n) * math.log2(c / n) for c in freq.values())


def extract_high_entropy_tokens(
    line: str,
) -> List[Tuple[str, float, str]]:
    """
    Split a line into candidate tokens and return those that exceed the
    entropy threshold.  Returns list of (token, entropy, description).
    """
    results = []
    # Split on typical delimiters / punctuation that surround credential values
    raw_tokens = re.split(r'[\s,;|{}\[\]()<>"\'`=:@\\]', line)

    for tok in raw_tokens:
        tok = tok.strip(".,;\"'`#")
        if not tok:
            continue

        length = len(tok)

        # --- Pure hex ---
        if length >= MIN_HEX_LEN and re.fullmatch(r'[0-9a-fA-F]+', tok):
            h = shannon_entropy(tok)
            if h > ENTROPY_THRESHOLD:
                results.append((tok, h, "high-entropy hex string"))
            continue  # already classified, don't double-check as base64

        # --- Base64-like ---
        if length >= MIN_BASE64_LEN:
            b64_ratio = sum(1 for c in tok if c in BASE64_CHARS) / length
            if b64_ratio >= BASE64_ALPHABET_RATIO:
                h = shannon_entropy(tok)
                if h > ENTROPY_THRESHOLD:
                    results.append((tok, h, "high-entropy base64-like string"))

    return results


# ─── Git helpers ─────────────────────────────────────────────────────────────

def get_staged_additions() -> List[Tuple[str, str, int]]:
    """
    Return (filename, line_content, line_number) for every *added* line in
    the current staging area.  Only added lines (+) are returned.
    """
    try:
        result = subprocess.run(
            [
                "git", "diff", "--cached",
                "--unified=0",          # no context lines - faster
                "--diff-filter=ACM",    # Added, Copied, Modified
                "--no-color",           # let git identify binary files before decoding
            ],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except subprocess.TimeoutExpired:
        print("pre-commit [secret-scan]: git diff timed out — skipping scan",
              file=sys.stderr)
        sys.exit(0)  # Don't block if git is broken

    lines = result.stdout.splitlines()
    additions: List[Tuple[str, str, int]] = []
    current_file: Optional[str] = None
    current_line = 0

    for raw in lines:
        # +++ b/path/to/file  → new file being diffed
        if raw.startswith("+++ b/"):
            current_file = raw[6:]
            current_line = 0
            continue

        # Skip diff metadata
        if (raw.startswith("--- ")
                or raw.startswith("diff --git")
                or raw.startswith("index ")
                or raw.startswith("new file")
                or raw.startswith("deleted file")
                or raw.startswith("Binary")):
            continue

        # @@ -a,b +c,d @@ — update line counter
        hunk_match = re.match(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@', raw)
        if hunk_match:
            current_line = int(hunk_match.group(1)) - 1
            continue

        # Added line
        if raw.startswith("+") and not raw.startswith("+++"):
            current_line += 1
            content = raw[1:]  # strip leading '+'
            if current_file:
                additions.append((current_file, content, current_line))
        elif not raw.startswith("-"):
            # Context line (shouldn't appear with --unified=0, but be safe)
            current_line += 1

    return additions


# ─── Finding model ───────────────────────────────────────────────────────────

class SecretFinding:
    __slots__ = ("filename", "line_number", "line", "kind", "detail")

    def __init__(self, filename: str, line_number: int, line: str,
                 kind: str, detail: str) -> None:
        self.filename = filename
        self.line_number = line_number
        self.line = line.rstrip()
        self.kind = kind
        self.detail = detail

    def format_block(self) -> str:
        display = self.line[:120] + ("…" if len(self.line) > 120 else "")
        return (
            f"  File    : {self.filename}\n"
            f"  Line    : {self.line_number}\n"
            f"  Type    : {self.kind}\n"
            f"  Info    : {self.detail}\n"
            f"  Content : {display}\n"
        )


# ─── Scanner ─────────────────────────────────────────────────────────────────

def scan() -> List[SecretFinding]:
    additions = get_staged_additions()
    findings: List[SecretFinding] = []
    seen: set = set()

    for filename, line, lineno in additions:
        # Skip binary/generated files
        basename = os.path.basename(filename)
        _, ext = os.path.splitext(filename)
        if ext.lower() in SKIP_EXTENSIONS or basename in SKIP_FILES:
            continue

        # Skip allowlisted lines
        if any(p.search(line) for p in ALLOWLIST_LINE_PATTERNS):
            continue

        # --- Pass 1: named pattern matching ---
        pattern_hit_this_line = False
        for kind, pattern in SECRET_PATTERNS:
            m = pattern.search(line)
            if m:
                key = (filename, lineno, kind)
                if key not in seen:
                    seen.add(key)
                    # Show the matched value (truncated)
                    matched = m.group(0)
                    truncated = matched[:60] + ("…" if len(matched) > 60 else "")
                    findings.append(SecretFinding(
                        filename=filename,
                        line_number=lineno,
                        line=line,
                        kind=kind,
                        detail=f'Matched: "{truncated}"',
                    ))
                    pattern_hit_this_line = True

        # --- Pass 2: entropy scan (only if no named pattern hit) ---
        if not pattern_hit_this_line:
            for token, entropy, description in extract_high_entropy_tokens(line):
                key = (filename, lineno, token[:24])
                if key not in seen:
                    seen.add(key)
                    short_tok = token[:50] + ("…" if len(token) > 50 else "")
                    findings.append(SecretFinding(
                        filename=filename,
                        line_number=lineno,
                        line=line,
                        kind=description,
                        detail=f"entropy={entropy:.2f}, len={len(token)}, value={short_tok}",
                    ))

    return findings


# ─── Main ─────────────────────────────────────────────────────────────────────

def main() -> int:
    findings = scan()
    if not findings:
        return 0

    # ANSI colours (safe; modern terminals always support these)
    RED    = "\033[0;31m"
    YELLOW = "\033[1;33m"
    CYAN   = "\033[0;36m"
    BOLD   = "\033[1m"
    DIM    = "\033[2m"
    RESET  = "\033[0m"

    border = RED + BOLD + "─" * 64 + RESET

    print(f"\n{border}")
    print(f"{RED}{BOLD}  SECRET SCANNER — COMMIT BLOCKED{RESET}")
    print(f"{border}\n")
    print(f"{YELLOW}  {len(findings)} potential secret(s) detected in staged files:{RESET}\n")

    for i, f in enumerate(findings, 1):
        print(f"{CYAN}{BOLD}  [{i}]{RESET}")
        for l in f.format_block().splitlines():
            print("  " + l)
        print()

    print(f"{border}")
    print(f"\n{BOLD}  How to fix:{RESET}")
    print(f"  1. Move the secret to an environment variable.")
    print(f"     Python:  value = os.environ['MY_SECRET']")
    print(f"     Shell:   value=$MY_SECRET")
    print(f"  2. Add the file to .gitignore if it must not be committed.")
    print(f"  3. Remove the secret, then: git add -p")
    print()
    print(f"{BOLD}  False positive?{RESET}")
    print(f"  - Suppress the line:  append  {CYAN}# git-secret-ignore{RESET}  to it")
    print(f"  - Bypass this commit: {CYAN}GIT_ALLOW_SECRETS=1 git commit{RESET}")
    print()
    print(f"{RED}{BOLD}  WARNING:{RESET} If this secret was already committed, rotate it NOW.")
    print(f"  {DIM}Deleting from HEAD is not enough — history is permanent.{RESET}")
    print(f"\n{border}\n")

    return 1


if __name__ == "__main__":
    sys.exit(main())
